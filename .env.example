# -------------------------------------------------------------------
# HIDAYAT:
#   1. Is file ka naam badal kar sirf  .env  kar dein
#      (yani ".example" hissa hata dein)
#   2. Neeche apni key paste kar dein  =  ke baad, bina spaces ke
#   3. File save kar dein. Bas! Ab  python main.py  chal jayega.
#
# NOTE: .env file GitHub par nahi jayegi (.gitignore usay rok deta hai)
#       isliye aapki key mehfooz rahegi.
# -------------------------------------------------------------------

# Gemini key yahan paste karein (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=yahan_apni_key_paste_karein

# Agar aap Claude use karna chahen to ye uncomment kar ke key daalein:
# ANTHROPIC_API_KEY=yahan_apni_key_paste_karein
